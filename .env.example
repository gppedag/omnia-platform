# --- Database ---
POSTGRES_DB=cup_system
POSTGRES_USER=cup_admin
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://cup_admin:changeme@postgres:5432/cup_system

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Necessario solo per creare admin/operator tramite /api/auth/register
ADMIN_BOOTSTRAP_TOKEN=change_this_bootstrap_token

# --- Asterisk AMI ---
AMI_HOST=asterisk
AMI_PORT=5038
AMI_USER=cup_ami
AMI_PASSWORD=changeme

# --- LiveKit ---
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# --- Notifiche ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=

# --- Chatbot multicanale ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_me
WHATSAPP_API_TOKEN=
FACEBOOK_PAGE_TOKEN=
CUP_SERVICES=Visita cardiologica,Visita dermatologica,Visita oculistica,Ecografia addome,Risonanza magnetica,Esami del sangue

APP_VERSION=1.0.30

# Upload documenti chatbot end-user
CHAT_UPLOAD_DIR=/data/uploads/chat
CHAT_MAX_UPLOAD_BYTES=10485760
CHAT_MAX_ATTACHMENTS=10

# --- Omnichannel / LLM v1.0.13 ---
LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:4000/v1
LLM_API_KEY=
LLM_MODEL=local-general
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=45

# Voice AI / NLU v1.0.28. Il provider LLM e' usato solo per comprensione/sentiment.
VOICE_NLU_ENABLED=true
VOICE_AI_SERVICE_TOKEN=change_me_voice_service_token
VOICE_NLU_CONFIDENCE_THRESHOLD=0.62
VOICE_MAX_UNDERSTANDING_FAILURES=2
VOICE_SENTIMENT_ENABLED=true
VOICE_SENTIMENT_HANDOFF_ENABLED=true

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=change_me
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_me

# Handoff telefonico Asterisk
ASTERISK_HANDOFF_ENABLED=false
OPERATOR_EXTENSION=201
HANDOFF_MODE=ring_group
HANDOFF_TIMEOUT_SECONDS=30
HANDOFF_TIMEOUT_ACTION=callback
HANDOFF_SERVICE_TOKEN=
HANDOFF_BROWSER_NOTIFICATIONS=true
ASTERISK_CONTEXT=from-internal
ASTERISK_CALLER_ID=CUP AI <700>
AMI_ORIGINATE_CHANNEL=Local/{extension}@from-internal
ASTERISK_VOICE_TEST_ENABLED=false
ASTERISK_VOICE_TEST_CONTEXT=cup-voice-ai-test
ASTERISK_VOICE_TEST_CHANNEL=Local/{number}@from-internal

# --- Chatwoot queue / operator console v1.0.13 ---
CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=https://chatwoot.example.it
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_INBOX_IDENTIFIER=
CHATWOOT_TEAM_ID=0
CHATWOOT_WEBHOOK_TOKEN=change_me
CHATWOOT_TIMEOUT_SECONDS=20
CHATWOOT_AUTO_SYNC_HANDOFF=true
CHATWOOT_HUB_MODE=true
CUP_PUBLIC_BASE_URL=https://demo-cup.example.it
PATIENT_BOOKING_PATH=/patient-portal.html?view=booking

# --- Continuazione telefono -> SMS -> Web (v1.0.13) ---
# Gateway HTTP generico: POST JSON {to, text, sender}. Se vuoto, modalita mock.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=CUP
SMS_TIMEOUT_SECONDS=20
CONTINUATION_TOKEN_TTL_MINUTES=30

# Google Calendar (OAuth 2.0)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Microsoft 365 / Graph
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Modalita prenotazioni esercizio: internal | external | chatbot_only
BOOKING_MODE=internal
EXTERNAL_BOOKING_NAME=Gestionale prenotazioni
EXTERNAL_BOOKING_URL=
EXTERNAL_BOOKING_EMBED_ENABLED=true

# Appointment reminders v1.0.17
REMINDERS_ENABLED=true
REMINDER_OFFSETS_HOURS=48,24,2
REMINDER_CHANNELS=sms,whatsapp,email
REMINDER_SEND_BOOKING_CONFIRMATION=true
REMINDER_ALLOW_CONFIRM_CANCEL=true
REMINDER_TOKEN_TTL_HOURS=168
REMINDER_POLL_SECONDS=60
REMINDER_MAX_ATTEMPTS=3
REMINDER_RETRY_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Dataset dimostrativo v1.0.17
DEMO_DATA_ENABLED=true
DEMO_AUTO_SEED=true
# Account di collaudo admin/operatore indipendenti dal dataset demo. Disabilitare in produzione.
DEMO_LOGIN_USERS_ENABLED=true
# SOLO SVILUPPO: abilita login con scelta Admin/Operatore senza password.
DEV_ROLE_LOGIN_ENABLED=true

# Lista d'attesa automatica
WAITLIST_ENABLED=true
WAITLIST_OFFER_TTL_MINUTES=20
WAITLIST_MAX_CANDIDATES=5

# Continuita di cura
FOLLOWUP_ENABLED=true
FOLLOWUP_DELAY_HOURS=24
FOLLOWUP_CHANNELS=sms,whatsapp,email
FOLLOWUP_TOKEN_TTL_HOURS=168
RECALL_ENABLED=true
RECALL_DEFAULT_DAYS=365
RECALL_CHANNELS=sms,whatsapp,email
RECALL_TOKEN_TTL_HOURS=720
CARE_POLL_SECONDS=60

# Pagamenti
PAYMENTS_ENABLED=true
PAYMENT_PROVIDER=manual
PAYMENT_DEFAULT_CURRENCY=EUR
PAYMENT_CHANNELS=sms,email,whatsapp
PAYMENT_LINK_TTL_HOURS=168
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
PAYMENT_EXTERNAL_URL_TEMPLATE=

# Firma documentale semplice
SIGNATURES_ENABLED=true
SIGNATURE_CHANNELS=sms,email,whatsapp
SIGNATURE_LINK_TTL_HOURS=168
SIGNATURE_MAX_FILE_BYTES=15728640

# v1.0.23 - Apprendimento AI supervisionato
TRAINING_ENABLED=true
TRAINING_CAPTURE_CHAT_ENABLED=true
# Training voce abilitato di default. L'IVR deve gestire l'informativa/consenso e il client
# deve continuare a trasmettere consent_obtained=true quando TRAINING_REQUIRE_CONSENT=true.
TRAINING_CAPTURE_VOICE_ENABLED=true
TRAINING_REQUIRE_CONSENT=true
TRAINING_SERVICE_TOKEN=
LIVEKIT_TRAINING_SYSTEM_PROMPT=Usa gli esempi approvati CUP per metodo, tono e domande. Non inventare disponibilita, non memorizzare dati personali e passa a un umano quando necessario.
